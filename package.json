{
  "name": "simulation-mcp-server",
  "version": "0.2.1",
  "description": "Local MCP server for STEP meshing and explicitly configured thermal, structural, modal, DC, and laminar-flow analysis with Gmsh and Elmer.",
  "type": "module",
  "mcpName": "io.github.ottonic/simulation-mcp-server",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "simulation-mcp-server": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "dist/package.json",
    "dist/contracts",
    "dist/worker",
    "!dist/**/*.map",
    "README.md",
    "docs/SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ottonic/simulation-mcp-server.git"
  },
  "homepage": "https://github.com/ottonic/simulation-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/ottonic/simulation-mcp-server/issues"
  },
  "author": "Matt Mohandiss <mattmohandiss@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "simulation",
    "fem",
    "finite-element",
    "elmer",
    "gmsh",
    "step",
    "thermal",
    "structural",
    "modal",
    "conduction",
    "cfd",
    "mechanical-engineering",
    "ai-tools"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepack": "npm run build",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "oxlint src tests",
    "fmt": "prettier --write src tests scripts package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.integration.config.ts",
    "fmt:check": "prettier --check src tests scripts package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.integration.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.2",
    "unitsnet-js": "^4.0.10",
    "vitest": "^5.0.5"
  }
}
