SIMULATION_INPUT_ROOTS=["/absolute/path/to/allowed/models"]
SIMULATION_WORKSPACE=/absolute/path/to/simulation-runs
SIMULATION_PYTHON=python3
SIMULATION_ELMERGRID=ElmerGrid
SIMULATION_ELMERSOLVER=ElmerSolver
SIMULATION_TIMEOUT_MS=120000
# Server logging (stderr only): level debug|info|warn|error, format json|human.
MCP_LOG_LEVEL=info
MCP_LOG_FORMAT=json
# Optional correlation id included in every log record.
MCP_TRACE_ID=
# Test-only: directory for temporary workspaces (defaults to the OS temp dir).
SIMULATION_TEST_TMP=/tmp
